# Local run uses the defaults. Leave the cloud values empty until we connect GCP.

# --- local Postgres, started with docker compose up -d ---
DATABASE_URL=postgresql+psycopg://transcode:transcode@127.0.0.1:5433/transcode
# STORAGE_DIR=ABSOLUTE_PATH/transcode/storage
# SESSION_SECRET=change-me-before-any-shared-deploy
# COOKIE_SECURE=0
# PUBLIC_BASE_URL=http://localhost:8000

# --- GCP, required only when the bytes and the queue leave the laptop ---
# GCP_PROJECT=
# GCS_INBOX_BUCKET=
# GCS_OUTPUT_BUCKET=
# PUBSUB_TOPIC=video-uploaded
# PUBSUB_SUBSCRIPTION=video-uploaded-worker
# On Cloud SQL, replace DATABASE_URL above with the instance connection string.
# Prefer: gcloud auth application-default login
# Only if you cannot use that: GOOGLE_APPLICATION_CREDENTIALS=/path/to/runtime-sa.json

# --- playback CDN, required only when the player stops using the API media route ---
# CDN_URL_PREFIX=https://media.example.com
# CDN_KEY_NAME=
# CDN_SIGNING_KEY=

# --- Firebase, required only when login stops being the local password check ---
# FIREBASE_PROJECT_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
